# Copy to .env. Never commit real credentials.
PEOPLEPULSE_ENVIRONMENT=local
PEOPLEPULSE_LOG_LEVEL=INFO
PEOPLEPULSE_WAREHOUSE_BACKEND=postgres
PEOPLEPULSE_SOURCE_DATABASE_URL=postgresql+psycopg://peoplepulse:peoplepulse@source-db:5432/people_source
PEOPLEPULSE_WAREHOUSE_DATABASE_URL=postgresql+psycopg://peoplepulse:peoplepulse@warehouse:5432/people_warehouse
PEOPLEPULSE_ASYNC_DATABASE_URL=postgresql+asyncpg://peoplepulse:peoplepulse@warehouse:5432/people_warehouse
PEOPLEPULSE_DATABASE_URL=postgresql+asyncpg://peoplepulse:peoplepulse@warehouse:5432/people_warehouse
PEOPLEPULSE_WAREHOUSE_SCHEMA=marts
PEOPLEPULSE_BATCH_SIZE=1000
PEOPLEPULSE_RETRY_COUNT=3
PEOPLEPULSE_DATA_GENERATOR_SEED=42
PEOPLEPULSE_PII_MASKING_MODE=strict
PEOPLEPULSE_API_HOST=0.0.0.0
PEOPLEPULSE_API_PORT=8000
PEOPLEPULSE_DASHBOARD_PORT=8501
PEOPLEPULSE_API_BASE_URL=http://api:8000
PEOPLEPULSE_ADMIN_TOKEN=local-admin-change-me
PEOPLEPULSE_ANALYST_TOKEN=local-analyst-change-me
PEOPLEPULSE_QUALITY_CRITICAL_THRESHOLD=0
PEOPLEPULSE_QUALITY_WARNING_THRESHOLD=0.05
PEOPLEPULSE_DATA_DIR=/opt/peoplepulse/data/generated

# Airflow local demo only
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Optional Snowflake adapter
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=PEOPLEPULSE_TRANSFORMER
SNOWFLAKE_WAREHOUSE=PEOPLEPULSE_TRANSFORMING
SNOWFLAKE_DATABASE=PEOPLEPULSE
SNOWFLAKE_SCHEMA=ANALYTICS
